# --- Home Assistant (required for current conditions) ---
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token

# Weather station device (device name or id). Its sensors are found automatically.
HA_WEATHER_STATION_DEVICE=GW2000A
# ...or set / override individual entities:
#HA_TEMPERATURE_ENTITY=sensor.outdoor_temperature
#HA_HUMIDITY_ENTITY=sensor.outdoor_humidity
#HA_PRESSURE_ENTITY=sensor.relative_pressure
#HA_WIND_SPEED_ENTITY=sensor.wind_speed
#HA_WIND_GUST_ENTITY=sensor.wind_gust
#HA_WIND_BEARING_ENTITY=sensor.wind_direction
#HA_RAIN_TODAY_ENTITY=sensor.daily_rain
#HA_FEELS_LIKE_ENTITY=sensor.feels_like_temperature

# --- Location (defaults to the Home Assistant home location) ---
#LATITUDE=50.4372
#LONGITUDE=15.3517
#LOCATION_NAME=Jičín
TZ=Europe/Prague

# --- Optional ---
#REFRESH_SECONDS=300
#OPEN_METEO_ENABLED=true
